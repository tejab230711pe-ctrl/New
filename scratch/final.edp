verbosity = 1;


real rpm       = 1200.0;
// Deposition activation threshold: 3 MPa is a calibrated process gate, not
// an AA5083 yield stress or a universal contact-pressure limit.  The local
// transfer fraction ramps linearly from zero at 0 MPa to one at 3 MPa.
// Calibrate it to the first measured, stable deposited track at this tool,
// rpm, feed, and plate condition; it gives about 1.47 kN over a 12.5 mm disk.
real criticalContactPressure = 3e6;
real contactPressureTolerance = 1.0e4;
real initialRodPlateGap = 0.0030;
// Machine coordinates are defined with Z=0 at plate contact.  Negative Z is
// above the plate, so the detailed approach is Z-3 to Z0.
real gcodeStartZ = -initialRodPlateGap;
real gcodeContactZ = 0.0;

real gcodeDwellZ = gcodeContactZ;
real gcodeApproachZ = gcodeContactZ;

// After reaching Z=0 contact, positive machine Z is a downward, compliant
// process feed.  It supplies the 35 mm commanded shortening that drives rod
// deformation and deposition during the simultaneous Y traverse.
real gcodeTraverseZ = 0.035;
real gcodeRetractZ = gcodeStartZ;
real gcodeTraverseY = 0.050;
real gcodeFeedProcess = 0.075/60.0;
real gcodeFeedRetract = 0.100/60.0;
real gcodeDwellTime = 4.0;
real machineAxialStiffness = 2.0e8;     
// Normal-contact penalty stiffness: p_n = k_p max(0,-g_n).  Retain a value
// high enough to limit interpenetration while the 15 kN machine ceiling
// protects the displacement-controlled experiment.
real contactPenaltyStiffness = 1.0e9;    // Pa/m
real plasticComplianceGain = 8.0;        // compliance growth with plasticization
// The machine is position commanded, but its normal axis responds compliantly
// to reaction force.  This produces a variable predicted Fz, subject to the
// explicit machine-protection ceiling below.
real normalServoBaseStiffness = 5.0e5;   // N/m
real normalServoForceScale = 5.0e3;      // N; stiffness softens above this load
real normalServoUpdateRelax = 0.25;      // stable update of compliant Z response
real dwellPreloadForce = 1.0e3;          // N, ramped after first Z=0 contact
real dwellPreloadRampTime = 0.50;        // s
// Z remains the command variable.  This is a machine-protection ceiling on
// solved Fz, not a normal operating-force target.
real axialForceMax = 15.0e3;
real rpmMax    = 2000.0;
real motorPowerMax = 22.0e3;
real torqueTransferEfficiency = 0.55;
real spindleFrictionPowerFraction = 0.80;
real rodRadius = 0.0125;
real loadedContactRadiusMin = 0.0080;
real rodHeight = 0.300;
real rodStopHeightFraction = 0.20;
// Set this to 0 in the constant-friction comparison case.
