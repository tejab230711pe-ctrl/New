Vh Dxx = 0.0, Dyy = 0.0, Dzz = 0.0, Dxy = 0.0, Dyz = 0.0, Dzx = 0.0;

// Stored plate Cauchy stress and total-strain history for J2 radial return.
// Cauchy stress is tension-positive; hydrostatic pressure remains the mixed
// incompressibility multiplier P.
Vh sigXX = 0.0, sigYY = 0.0, sigZZ = 0.0;
Vh sigXY = 0.0, sigYZ = 0.0, sigZX = 0.0;
