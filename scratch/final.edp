Vh sigDevxy = 0.0, sigDevyz = 0.0, sigDevzx = 0.0;
Vh momentumDelta = 0.0;
Vh realDepositDensity = 0.0, virtualVoid = 1.0, rodContactFlux = 0.0;
Vh rodTrackDensity = 0.0, rodTrackDensityOld = 0.0, rodMassSource = 0.0;
Vh rodMassFluxX = 0.0, rodMassFluxY = 0.0, rodMassFluxZ = 0.0, rodMassFluxMag = 0.0;
Vh rodMassAdvection = 0.0;
Vh defX = 0.0, defY = 0.0, defZ = 0.0, defMag = 0.0;
Vh strainTrace = 0.0, vonMisesStrain = 0.0, vonMisesStress = 0.0;
Vh heatFluxX = 0.0, heatFluxY = 0.0, heatFluxZ = 0.0, heatFluxMag = 0.0;
Xh [Ux, Uy, Uz, P] = [0.0, 0.0, 0.0, 0.0];
Xh [Uoldx, Uoldy, Uoldz, Pold] = [0.0, 0.0, 0.0, 0.0];
Xh [Wx, Wy, Wz, Q];
Xh [UxSolve, UySolve, UzSolve, pressureUnknown] = [0.0, 0.0, 0.0, 0.0];
Xh [vx, vy, vz, q];
Rh TrodField = Tair, TrodOld = Tair, rv;
Rh rodMask, rodContactMask, rodActiveLayer, rodSource, rodFrictionSource;
Rh rodContactState = 0.0;
Rh rodPlasticDissipationField, rodPlasticAppliedField = 0.0, rodEtaField = etaMax;
Rh rodStrainRateField = 0.0, rodEqStressField = 0.0, rodFlowStressField = yieldRT;
RXh [RUx, RUy, RUz, RP] = [0.0, 0.0, 0.0, 0.0];
RXh [RUoldx, RUoldy, RUoldz, RPold] = [0.0, 0.0, 0.0, 0.0];
RXh [RWx, RWy, RWz, RQ];
Rh RUxSolve = 0.0, RUySolve = 0.0, RUzSolve = 0.0;


macro div3(ux,uy,uz) (dx(ux)+dy(uy)+dz(uz)) //
macro Sxx(ux,uy,uz) (dx(ux)) //
macro Syy(ux,uy,uz) (dy(uy)) //
macro Szz(ux,uy,uz) (dz(uz)) //
macro Sxy(ux,uy,uz) (0.5*(dy(ux)+dx(uy))) //
macro Syz(ux,uy,uz) (0.5*(dz(uy)+dy(uz))) //
macro Szx(ux,uy,uz) (0.5*(dz(ux)+dx(uz))) //
T = Tair;
Told = T;
TrodField = Tair;
TrodOld = TrodField;


ofstream history("consumable_rod_history.csv");
history << "time_s,x_tool_m,y_tool_m,Tmax_K,Tavg_K,base_plate_plastic_volume_m3,max_height_m"
        << ",max_flash_m,axial_feed_mm_min,Qf_plate_applied_W,Qf_raw_interface_W,Qf_disk_formula_W,friction_model_active,Qplastic_W"
        << ",Qrod_plastic_W,Qplate_W,Qtotal_system_W,Qconv_loss_W,Qfixture_loss_W,Qside_loss_W,Qrad_loss_W,Qrad_emit_W,Qstored_W,Qnet_W"
        << ",mu_contact,flow_stress_softening_factor,rpm_actual,rpm_command,spindle_torque_Nm,spindle_required_power_W"
        << ",axial_load_kN,force_limit_active,p_rod_MPa,k_contact_W_mK,thermal_contact_conductance_W_m2K"
        << ",cp_contact_J_kgK,cp_eff_contact_J_kgK,rho_contact_kg_m3,E_contact_GPa,yield_contact_MPa"
        << ",deposited_volume_mm3,flash_volume_mm3,max_velocity_m_s,max_mesh_velocity_m_s"
        << ",max_activation,min_eta_Pa_s,max_pressure_MPa,rod_temp_K"
        << ",rod_plasticized,rod_eq_stress_MPa,rod_flow_stress_MPa,rod_strain_rate_1_s"
        << ",loaded_contact_radius_mm,expanded_material_shoulder_radius_mm,annulus_equivalent_inner_radius_mm,annulus_outer_radius_mm,annulus_width_mm,annulus_resolved_area_mm2"
        << ",effective_contact_area_mm2,geometric_contact_area_mm2,integrated_contact_area_mm2"
        << ",mushy_volume_m3,mean_total_strain_rate_in_plastic_zone_1_s,mean_plastic_strain_rate_1_s,mean_jc_rate_factor,mean_plastic_strain,mean_jc_flow_stress_MPa,real_deposit_density"
        << ",plate_effusivity_share,rod_effusivity_share,max_friction_shear_MPa,max_shear_critical_MPa"
        << ",base_plate_max_deformation_m,base_plate_vm_strain,base_plate_vm_stress_MPa"
        << ",base_plate_plastic_strain,base_plate_plastic_strain_rate_1_s,max_heat_flux_W_m2"
        << ",effective_rod_radius_mm,effective_rod_diameter_mm,rod_length_remaining_mm"
        << ",contact_indentation_um,stick_fraction"
        << ",rod_elastic_axial_um,rod_elastic_bending_um,rod_elastic_twist_rad"
        << ",eulerian_mesh_fixed"
        << endl;


ofstream snapshots("consumable_rod_snapshots.csv");
snapshots << "frame,time_s,x_m,y_m,z_m,T_K,height_mm,flash_mm"
          << ",base_plate_compaction_m,material_free_surface_z_m,base_plate_plasticized,mushy_fraction"
          << ",activation,ux_m_s,uy_m_s,uz_m_s,mesh_vz_m_s,pressure_Pa,eta_Pa_s"
