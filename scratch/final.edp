cout << "Tool path            = Z-3 to Z0 approach, 4 s dwell at Z0, simultaneous Y0 to Y50 and Z0 to Z35, then Z35 to Z-3 retract" << endl;
cout << "Contact dwell        = " << penetrationDwellTime
     << " s at Z0" << endl;
cout << "Dwell temperature    = solved result only; no target-temperature heater" << endl;
cout << "Plasticizing/latent-heat band = " << TplasticLow-273.15 << " to "
