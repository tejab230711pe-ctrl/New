load "msh3"
int bottomLabel = 5;
int topLabel = 6;
mesh3 Th = cube(nx, ny, nz,
                [plateLx*x,
                 plateLy*y,
                 plateT*(1.0-(1.0-z)^topMeshPower)]);
mesh3 Rod = cube(rodNx, rodNy, rodNz,
                 [xMin + (xMax-xMin)*x,
                  yMin + (yMax-yMin)*y,
                  plateT + rodHeight*z]);
fespace Vh(Th, P1);
// Low-memory equal-order velocity/pressure pair.  The PSPG/GLS term in the
// momentum form below stabilizes the P1 hydrostatic-pressure field.
fespace Xh(Th, [P1, P1, P1, P1]);
fespace Rh(Rod, P1);
fespace RXh(Rod, [P1, P1, P1, P1]);
Vh T = Tair, Told = Tair, v;
Vh source, frictionSource, frictionSurfaceFlux, plasticSource, plasticized, mushyFractionField, contactMask, rContact;
Vh heatLayerMask, mushyZoneMask, plasticZoneMask, shearAnnulusMask;
Vh plasticizingTemperatureMask, frictionCoefficientField = muReference;
