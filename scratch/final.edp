ofstream spatialFrames("consumable_rod_spatial_frames.csv");
spatialFrames << "frame,time_s,object,center_x_m,center_y_m,base_z_m"
              << ",size_x_m,size_y_m,height_m,radius_m,base_plate_reduction_m"
