real muMin     = 0.25;
real muMax     = 0.70;
// ANSYS-style FWGT equivalent.  With the default 0, use the physically based
// effusivity split below; set to 1 to impose the calibrated fixed plate share.
int useFixedFrictionHeatPartition = 0;
real frictionHeatPlateWeight = 0.50;
real plateHeatPartition = 0.50;



real contactHeatRadius = rodRadius;
real contactEdgeWidth = 0.003;
real penetrationDwellTime = gcodeDwellTime;
real travelV   = gcodeFeedProcess;
real travelVx  = 0.0;
real travelVy  = travelV;
real travelSpeed = max(1.e-12, sqrt(travelVx^2 + travelVy^2));
real travelDirX = travelVx/travelSpeed;
real travelDirY = travelVy/travelSpeed;


// AA5083 values at 20 C, linearly interpolated from the supplied -20/80 C data.
real rhoRT     = 2661.42;
real cpRT      = 948.14;
real kRT       = 116.58;
real alphaRT   = 23.8e-6;
real ERT       = 70.3e9;
real mechanicalModulusFloor = 1.0e6;
real yieldRT   = 145.0e6;
real nuRT      = 0.33;
real hConv     = 25.0;
real emiss     = 0.20;
real Tair      = 293.15;
real sigmaSB   = 5.670374419e-8;


real Tsol   = 864.15; // 591 C, AA5083-O solidus
real Tliq   = 911.15; // 638 C, AA5083-O liquidus
real TplasticLow  = 273.15 + 0.6*(Tsol-273.15);
real TplasticHigh = 273.15 + 0.9*(Tsol-273.15);
real Lf     = 387000.0;
// The requested effective latent-heat/plasticization interval is 0.6--0.9
// of solidus temperature.  It is a model regularization interval, not the
// measured solidus--liquidus range.
real dTmush = TplasticHigh-TplasticLow;
// Keep heat input within the requested plasticization interval: begin
// reducing at 0.6*Tsolidus and taper continuously through the full band.
real TcontrolHardLimit = TplasticHigh;
real TcontrolTarget    = TplasticLow;

func real interpAA5083Thermal(real Tk,
                              real vm20, real v80, real v180, real v280,
                              real v380, real v480, real v580)
{
    real Tc = Tk-273.15;
    if (Tc <= -20.0) return vm20;
    if (Tc <= 80.0)  return vm20+(v80-vm20)*(Tc+20.0)/100.0;
    if (Tc <= 180.0) return v80+(v180-v80)*(Tc-80.0)/100.0;
    if (Tc <= 280.0) return v180+(v280-v180)*(Tc-180.0)/100.0;
    if (Tc <= 380.0) return v280+(v380-v280)*(Tc-280.0)/100.0;
    if (Tc <= 480.0) return v380+(v480-v380)*(Tc-380.0)/100.0;
    if (Tc <= 580.0) return v480+(v580-v480)*(Tc-480.0)/100.0;
    // Continue the final measured slope only to the liquidus reference.
    real TcCapped = min(Tc, Tliq-273.15);
    return max(0.0, v580+(v580-v480)*(TcCapped-580.0)/100.0);
}

func real rhoOfT(real Tk) {
    return interpAA5083Thermal(Tk, 2673.9, 2642.7, 2629.4, 2611.5,
                                2589.3, 2567.0, 2549.2);
}
func real kOfT(real Tk) {
    return interpAA5083Thermal(Tk, 112.5, 122.7, 131.6, 142.3,
                                152.5, 159.5, 177.2);
}
func real cpOfT(real Tk) {
    return interpAA5083Thermal(Tk, 924.1, 984.2, 1039.6, 1081.2,
                                1136.6, 1178.2, 1261.4);
}
func real alphaOfT(real Tk) {
    return 23.8e-6;
}
func real EOfT(real Tk) {
    return 70.3e9;
}
func real yieldOfT(real Tk) {
    real Tc = Tk-273.15;
    // AA5083-O tensile yield-strength data supplied by the user (MPa).
    if (Tc <= -195.0) return 165.0e6;
    if (Tc <= -80.0)  return 165.0e6+(145.0e6-165.0e6)*(Tc+195.0)/115.0;
    if (Tc <= -30.0)  return 145.0e6;
    if (Tc <= 25.0)   return 145.0e6;
    if (Tc <= 100.0)  return 145.0e6;
    if (Tc <= 150.0)  return 145.0e6+(130.0e6-145.0e6)*(Tc-100.0)/50.0;
    if (Tc <= 205.0)  return 130.0e6+(115.0e6-130.0e6)*(Tc-150.0)/55.0;
    if (Tc <= 260.0)  return 115.0e6+(75.0e6-115.0e6)*(Tc-205.0)/55.0;
    if (Tc <= 315.0)  return 75.0e6+(50.0e6-75.0e6)*(Tc-260.0)/55.0;
    if (Tc <= 370.0)  return 50.0e6+(29.0e6-50.0e6)*(Tc-315.0)/55.0;
    return 29.0e6;
}
func real nuOfT(real Tk) {
    return 0.33;
}

func real mushyFraction(real Tk){
    if (Tk <= TplasticLow) return 0.0;
    if (Tk >= TplasticHigh) return 1.0;
    return (Tk-TplasticLow)/dTmush;
}

func real dmushyFractiondT(real Tk){
    if (Tk <= TplasticLow || Tk >= TplasticHigh) return 0.0;
    return 1.0 / dTmush;
}


func real kSolid(real Tk){
    return kOfT(Tk);
}
real kLiquid = 177.2;

func real cpSolid(real Tk){
    return cpOfT(Tk);
}
real cpLiquid = 1261.4;


func real kEff(real Tk){
    real fl = mushyFraction(Tk);
    return (1.0 - fl)*kSolid(Tk) + fl*kLiquid;
}
func real cpEff(real Tk){
    real fl    = mushyFraction(Tk);
    real base  = (1.0 - fl)*cpSolid(Tk) + fl*cpLiquid;
    real spike = Lf * dmushyFractiondT(Tk);

    return base + spike;
}


real jcA       = 255.21e6;
real jcB       = 735.80e6;
real jcN       = 1.075;
real epsPlastic0 = 1.0e-4;
real epsDot0   = 1.0;
real jcC       = 0.0028;
real jcM       = 0.654;
real TroomJC   = Tair;
real betaTaylor = 0.90;
real Tmelt     = Tliq;

func real muOfT(real Tk) {
    if (!useVariableMu) return muReference;
    real theta = min(1.0, max(0.0, (Tk-Tair)/max(1.0, Tsol-Tair)));
    return min(muMax, max(muMin, muReference-(muReference-muMin)*theta));
}
func real softeningFactor(real Tk) {
    real tStar = min(1.0, max(0.0,
                     (Tk-TroomJC)/max(1.0, Tmelt-TroomJC)));
    return max(0.0, 1.0-tStar^jcM);
}
func real jcThermalFactor(real Tk) {
    return softeningFactor(Tk);
}
func real jcRateFactor(real epsRate) {
    // Standard Johnson--Cook rate term with only a zero-rate numerical guard.
    return 1.0 + jcC*log(max(epsRate, 1.e-12)/epsDot0);
}
func real jcFlowStress(real epsp, real epsRate, real Tk) {
    return (jcA + jcB*max(0.0, epsp)^jcN)
          *jcRateFactor(epsRate)
          *jcThermalFactor(Tk);
}
func real heatGovernor(real Tk) {
    if (Tk <= TcontrolTarget) return 1.0;
    if (Tk >= TcontrolHardLimit) return 0.0;
    return (TcontrolHardLimit-Tk)
         / max(1.0, TcontrolHardLimit-TcontrolTarget);
}
// Full Coulomb rotating-disk torque.  This is the requested friction-only
// model: no sticking/sliding switch or relative-velocity multiplier is used.
func real diskFrictionTorque(real mu, real pMean, real radiusNow) {
    return max(0.0, mu)*max(0.0, pMean)
         * 2.0*pi*max(0.0, radiusNow)^3/3.0;
}
// Angular speed converts torque to mechanical power (W).  The efficiency is
// a heat-conversion calibration factor, not part of the mechanical torque.
func real diskFrictionPower(real efficiency, real mu, real pMean,
                            real omegaNow, real radiusNow) {
    return max(0.0, efficiency)*diskFrictionTorque(mu, pMean, radiusNow)
         * max(0.0, omegaNow);
}
real plateLx   = 0.250;
real plateLy   = 0.300;
real plateT    = 0.020;
// Machine datum: rod-tip home is 300 mm above the base-plate top surface.
// The detailed thermo-mechanical model begins at the final 3 mm approach;
// the long non-contact home-to-approach travel is intentionally not meshed.
real rodHomeTipZ = plateT + rodHeight;
real simulatedApproachStartTipZ = plateT + initialRodPlateGap;
real gcodeHomeZ = -(rodHomeTipZ-plateT);
real spatialCoordinateTolerance = 0.0005;
real plateCompactionFraction = 0.10;
real plateCompactionMax = 0.20*plateT;
real depositW  = 2.0*rodRadius;
real depositL  = gcodeTraverseY;
real activeDepth = plateT;
real heatSourceDepth = min(activeDepth, 0.0030);
real topActivationDepth = min(activeDepth, 0.0030);
real plasticHeatRadius = contactHeatRadius;
real plasticHeatDepth = min(plateT, 0.010);
real plasticShearThickness = 0.010;
real rodPlasticDepth = rodHeight;


real etaMin = 2.0e3;
real etaMax = 2.0e8;
real etaReg = 1.0e-4; // smooth regularization for the velocity tangent
real etaMushyMin = 8.0e3;
real velocityRelax = 0.35;
real toolCoupling = 5.0e8;
real topMeshPower = 2.75;
real activationRate = 10.0;
real inactiveLayerDamping = 1.0e6;
real rodHeatLossFraction = 1.0-plateHeatPartition;
// ANSYS-style thermal contact conductance (TCC): pressure/temperature
// dependent rather than a fixed value.  These are calibration parameters.
real rodContactConductanceRef = 2.0e4;   // W/(m^2 K), at 3 MPa and Tair
real contactConductancePressureRef = 3.e6;
real contactConductancePressureExponent = 0.50;
real contactConductanceTempExponent = 0.25;
real fixtureConductance = 5.0e3;         // W/(m^2 K), bottom backing plate
real sideConvection = 25.0;               // W/(m^2 K), exposed plate sides
real rodMassDiffusivity = 1.0e-8;

// Thermal contact conductance follows the common TCC calibration form: it
// increases with compressive pressure and varies mildly with temperature.
func real contactConductanceOfTP(real Tk, real pMean) {
    real pRatio = max(0.0, pMean)/max(1.0, contactConductancePressureRef);
    real tRatio = max(0.1, Tk/max(1.0, Tair));
    return rodContactConductanceRef
         * max(0.05, pRatio^contactConductancePressureExponent)
         * tRatio^contactConductanceTempExponent;
}

real contactRadiusRelax = 0.35;
real stickSlipVelocityTolerance = 1.e-3;
// All modeled frictional dissipation is converted to heat by the calibrated
// efficiency.  No stick/slip partition is imposed on the plate interface.
real frictionHeatEfficiency = 1.0;
real heatInputRelax = 1.0;
real heatRampTime = 1.0;
int enableALE = 1;
int aleMoveEvery = 2;
real aleRelax = 0.20;
real aleMaxStep = 0.00010;
real minMeshVolume = 1.e-14;
real aleQualityLimit = 0.20;

real dt        = 0.25;
int debugMode = 0;
int debugSteps = 1;
int nx         = debugMode ? 8 : 20;
int ny         = debugMode ? 8 : 20;
int nz         = debugMode ? 6 : 16;
real pspgElementLength = min(plateLx/nx, min(plateLy/ny, plateT/nz));
int rodNx      = debugMode ? 5 : 12;
int rodNy      = debugMode ? 8 : 24;
int rodNz      = debugMode ? 6 : 16;
