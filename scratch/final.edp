cout << "Effective latent interval     = " << TplasticLow-273.15 << " to "
     << TplasticHigh-273.15 << " C in cpEff(T)" << endl;
cout << "cpEff at band low    = " << cpEff(TplasticLow) << " J/(kg K)" << endl;
cout << "cpEff at band high   = " << cpEff(TplasticHigh) << " J/(kg K)" << endl;
cout << "Active/heat depths   = " << activeDepth*1000.0 << " / "
     << heatSourceDepth*1000.0 << " mm" << endl;
cout << "Qf is controlled by spindle speed, Coulomb friction, loaded radius, and computed contact pressure." << endl;
cout << "One rod volume       = " << oneRodVolume*1.e9 << " mm^3" << endl;
cout << "Base plate mechanics = deformable; bottom surface is fixture-clamped" << endl;
cout << "Rod plasticizing model = H(rodEqStress-rodFlowStress) H(Trod-TplasticLow) H(TplasticHigh-T)" << endl;
cout << "Rod stop length      = " << rodStopHeight*1000.0
     << " mm (" << rodStopHeightFraction*100.0 << "% remaining)" << endl;
cout << "Traverse duration    = " << traverseTime << " s" << endl;
cout << "Contact/heat duration= " << passTime << " s" << endl;
