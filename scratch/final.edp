cout << "ALE meshing          = " << (enableALE ? "active" : "disabled")
     << ", update interval=" << aleMoveEvery << " step(s)" << endl;
cout << "G-code dwell         = P" << gcodeDwellTime
     << " s at Z0; a ramped normal-servo preload is applied after contact" << endl;
cout << "G-code traverse      = simultaneous Y0 to Y50 and Z0 to Z35 after dwell" << endl;
cout << "G-code retract       = Z35 to Z-3 at F100" << endl;
cout << "Machine power limit  = " << motorPowerMax << " W" << endl;
cout << "Interface power cap  = " << spindlePowerAvailable << " W" << endl;
cout << "Friction power budget= " << spindleFrictionPowerBudget << " W" << endl;
cout << "Contact pressure     = compressive component of solved momentum pressure" << endl;
cout << "Heat contact radius  = " << contactHeatRadius*1000.0 << " mm" << endl;
cout << "mu(Tair)             = " << currentMu << endl;
cout << "Flow-stress softening= Johnson-Cook temperature dependent" << endl;
