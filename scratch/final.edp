real rodStopHeight = rodStopHeightFraction*rodHeight;
real rodConsumableHeight = (1.0-rodStopHeightFraction)*rodHeight;
real oneRodVolume = contactArea*rodHeight;
real rodSolidVolumeRemaining = oneRodVolume;

real gcodeApproachTime = 1.6;
real xStart = 0.5*plateLx - 0.5*depositL*travelDirX;
real xEnd   = 0.5*plateLx + 0.5*depositL*travelDirX;
real yStart = 0.5*plateLy - 0.5*depositL*travelDirY;
real yEnd   = 0.5*plateLy + 0.5*depositL*travelDirY;
real xMin = min(xStart, xEnd)-rodRadius;
real xMax = max(xStart, xEnd)+rodRadius;
real yMin = min(yStart, yEnd)-rodRadius;
real yMax = max(yStart, yEnd)+rodRadius;
real traverseTime = depositL/travelSpeed;
real dwellTimeBudget = penetrationDwellTime;
real retractTime = abs(gcodeRetractZ-gcodeTraverseZ)/gcodeFeedRetract;
real processEndTime = gcodeApproachTime + dwellTimeBudget + traverseTime;
real passTime = processEndTime + retractTime;
real totalTime = passTime;
int nSteps = ceil(totalTime/dt);

cout << "=== Consumable rod friction deposition ===" << endl;
cout << "Rotation speed       = " << rpm << " rpm" << endl;
cout << "Axial load           = predicted contact reaction from commanded Z motion" << endl;
cout << "Normal servo         = compliant; " << dwellPreloadForce/1000.0
