rpm = rpmCommand;
real omegaCommand = 2.0*pi*rpmCommand/60.0;
real omega = omegaCommand;
real contactArea = pi*rodRadius^2;
real axialLoad = 0.0;
real currentMu = muOfT(Tair);
real currentSoftening = softeningFactor(Tair);
rpmCommand = min(rpmCommand, rpmMax);
rpm = rpmCommand;
omegaCommand = 2.0*pi*rpmCommand/60.0;
omega = omegaCommand;
real spindleLoadTorque = 0.0;
real spindleRequiredPower = 0.0;
real spindlePowerAvailable = torqueTransferEfficiency*motorPowerMax;
real spindleFrictionPowerBudget = spindleFrictionPowerFraction*spindlePowerAvailable;
real contactPressure = 0.0;
real cpContactEff = cpRT;
